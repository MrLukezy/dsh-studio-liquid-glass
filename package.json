{
  "name": "dsh-studio-liquid-glass",
  "version": "0.12.82",
  "description": "Studio fork of dsh-liquid-glass. Owns the theme settings tab, mobile liquid-glass layout, and wallpaper routes under /dsh-liquid-glass.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "liquid-glass",
    "glassmorphism"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "src/client",
    "scripts/build-client.mjs",
    "scripts/generate-optics-fallbacks.mjs",
    "scripts/png-codec.mjs",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:optics": "node scripts/generate-optics-fallbacks.mjs",
    "generate:optics:check": "node scripts/generate-optics-fallbacks.mjs --check",
    "build": "npm run generate:optics && node scripts/build-client.mjs",
    "build:check": "npm run generate:optics:check && node scripts/build-client.mjs --check",
    "test": "npm run build:check && node --test test/*.test.mjs",
    "quality": "npm run build:check && node --check host.js && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLukezy/dsh-studio-liquid-glass.git"
  }
}
